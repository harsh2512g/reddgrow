#!/bin/sh
# Anonymous public pulls only. No credential input is read or stored.
case "${1-}" in
  list)
    printf '{}\n'
    ;;
  get)
    # Docker's helper protocol recognizes this fixed message as absent credentials.
    # This helper never invokes or reads a platform keychain.
    printf 'credentials not found in native keychain\n'
    exit 1
    ;;
  store|erase)
    printf 'ThreadSignal registry credential storage is disabled.\n'
    exit 1
    ;;
  *)
    printf 'Unsupported credential helper operation.\n'
    exit 1
    ;;
esac
