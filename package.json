{
  "name": "threadsignal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <27"
  },
  "scripts": {
    "preinstall": "node scripts/check-install.mjs",
    "dev": "turbo run dev --concurrency=20 --filter=@threadsignal/web... --filter=@threadsignal/worker...",
    "dev:hosted": "node scripts/hosted-supabase.mjs dev",
    "build:hosted": "node scripts/hosted-supabase.mjs build",
    "supabase:check": "node scripts/hosted-supabase.mjs check",
    "supabase:prepare": "node scripts/prepare-hosted-supabase.mjs",
    "supabase:check:phase2": "node scripts/migrate-hosted-phase2.mjs check",
    "supabase:migrate:phase2": "node scripts/migrate-hosted-phase2.mjs apply",
    "worker:prepare:local": "node scripts/hosted-worker.mjs prepare-local",
    "worker:provision:hosted": "node scripts/hosted-worker.mjs provision",
    "worker:hosted": "node scripts/hosted-worker.mjs start",
    "build": "turbo run build",
    "lint": "eslint . && pnpm --filter @threadsignal/web lint",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck": "turbo run typecheck && tsc -p tsconfig.tooling.json",
    "test": "turbo run build --filter='./packages/*' && vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "services:start": "node scripts/services.mjs start",
    "services:stop": "node scripts/services.mjs stop",
    "services:health": "node scripts/services.mjs health",
    "db:reset": "node scripts/database.mjs reset",
    "db:migrate": "node scripts/database.mjs migrate",
    "seed": "node scripts/database.mjs seed",
    "db:types": "node scripts/database.mjs types",
    "db:lint": "node scripts/database.mjs lint",
    "secrets:check": "node scripts/check-secrets.mjs",
    "extension:build": "pnpm --filter @threadsignal/extension build",
    "test:extension": "playwright test --config playwright.extension.config.ts",
    "cleanroom:verify": "node scripts/cleanroom.mjs verify"
  },
  "packageManager": "pnpm@12.4.1",
  "devDependencies": {
    "@threadsignal/opportunities": "workspace:*",
    "@threadsignal/knowledge": "workspace:*",
    "@supabase/supabase-js": "2.116.0",
    "yaml": "2.9.1",
    "@threadsignal/ai": "workspace:*",
    "@threadsignal/reddit": "workspace:*",
    "@threadsignal/crawler": "workspace:*",
    "@threadsignal/email": "workspace:*",
    "@threadsignal/billing": "workspace:*",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.4",
    "@types/chrome": "0.2.9",
    "eslint": "9.39.5",
    "esbuild": "0.28.2",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "turbo": "2.10.12",
    "tsx": "4.23.13",
    "vitest": "4.1.11",
    "supabase": "2.117.0",
    "postgres": "3.4.9",
    "ioredis": "6.0.0",
    "zod": "4.6.4",
    "@threadsignal/drafts": "workspace:*",
    "@threadsignal/extension-contracts": "workspace:*",
    "@threadsignal/tracking": "workspace:*",
    "@threadsignal/analytics": "workspace:*"
  }
}
